{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledMcpjsonServers": ["banco-producao"],
  "permissions": {
    "allow": [
      "Bash(.venv/bin/pytest *)",
      "Bash(.venv/bin/ruff *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(python3 scripts/consultar_local.py *)",
      "mcp__banco-producao__consultar_producao"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./dados-sensiveis/**)",
      "Bash(git push *)",
      "Bash(rm -rf *)"
    ]
  }
}
